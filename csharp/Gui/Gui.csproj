<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- 수업 메모 도구 동봉: Windows 대상 publish(-r win-*) 시 메모를 단일 exe로 publish해 메인 exe에 리소스로 넣는다.
       메인 앱이 실행되면 %LOCALAPPDATA%\SaenggibuHelper\수업메모.exe 로 꺼내 쓴다 → 포털이 Gui만 빌드해도 메모 포함.
       개발 빌드(-r 없음)는 건너뜀. 강제: -p:EmbedMemo=true / 끄기: -p:EmbedMemo=false -->
  <PropertyGroup>
    <EmbedMemo Condition="'$(EmbedMemo)' == '' And $(RuntimeIdentifier.StartsWith('win'))">true</EmbedMemo>
    <MemoRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MemoRid>
    <MemoRid Condition="'$(MemoRid)' == ''">win-x64</MemoRid>
    <MemoPublishDir>$(MSBuildProjectDirectory)/obj/memo-embed/$(MemoRid)/</MemoPublishDir>
    <MemoZip>$(MSBuildProjectDirectory)/obj/memo-embed/memo-$(MemoRid).zip</MemoZip>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedMemo)' == 'true'">
    <MemoEmbedInputs Include="../Memo/**/*.cs;../Memo/Memo.csproj;../Memo/app.manifest;../Memo/Assets/**;../Core/RosterData.cs;../Core/Settings.cs;../Core/Prompts.cs;../Core/PromptsData.cs;../Core/Autostart.cs"
                     Exclude="../Memo/bin/**;../Memo/obj/**" />
  </ItemGroup>

  <Target Name="PublishMemoForEmbed" Condition="'$(EmbedMemo)' == 'true'" Inputs="@(MemoEmbedInputs)" Outputs="$(MemoZip)">
    <PropertyGroup>
      <_MemoDotnet>$(DOTNET_HOST_PATH)</_MemoDotnet>
      <_MemoDotnet Condition="'$(_MemoDotnet)' == ''">dotnet</_MemoDotnet>
    </PropertyGroup>
    <RemoveDir Directories="$(MemoPublishDir)" />
    <!-- DebugType=none: pdb 없이 exe 하나만 나오게(zip에 pdb가 섞이지 않도록) -->
    <Exec Command="&quot;$(_MemoDotnet)&quot; publish &quot;$(MSBuildProjectDirectory)/../Memo/Memo.csproj&quot; -c Release -r $(MemoRid) --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=none -p:DebugSymbols=false -o &quot;$(MemoPublishDir)&quot;" />
    <!-- NuGet이 같이 복사하는 네이티브 디버그 파일(libSkiaSharp.pdb 80MB 등)은 zip에서 제외 -->
    <ItemGroup>
      <_MemoPdb Include="$(MemoPublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_MemoPdb)" />
    <!-- 메인 exe에는 압축해 넣는다(93MB → 약 40MB). 설치할 때 풀어서 쓰므로 메모 실행 속도는 그대로. -->
    <Delete Files="$(MemoZip)" />
    <ZipDirectory SourceDirectory="$(MemoPublishDir)" DestinationFile="$(MemoZip)" Overwrite="true" />
  </Target>

  <Target Name="EmbedMemoResource" BeforeTargets="PrepareForBuild" DependsOnTargets="PublishMemoForEmbed" Condition="'$(EmbedMemo)' == 'true'">
    <Error Condition="!Exists('$(MemoZip)')" Text="수업 메모 도구 publish 결과가 없습니다: $(MemoZip)" />
    <ItemGroup>
      <EmbeddedResource Include="$(MemoZip)" LogicalName="memo.zip" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>
</Project>
